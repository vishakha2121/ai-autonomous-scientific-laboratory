📄 backend/app/core/logger.py
python
"""
Centralized logger for all agents and services.
"""

import logging
import sys
from datetime import datetime


def get_logger(name: str, level: int = logging.INFO) -> logging.Logger:
    """
    Ek configured logger return karta hai.

    Args:
        name: Logger ka naam (usually agent/service name)
        level: Logging level (default INFO)

    Returns:
        Configured Logger instance
    """
    logger = logging.getLogger(name)

    # Agar already handlers hain to duplicate mat karo
    if logger.handlers:
        return logger

    logger.setLevel(level)

    # Console handler
    handler = logging.StreamHandler(sys.stdout)
    handler.setLevel(level)

    # Format: [TIME] [LEVEL] [NAME] message
    formatter = logging.Formatter(
        fmt="[%(asctime)s] [%(levelname)s] [%(name)s] %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )
    handler.setFormatter(formatter)

    logger.addHandler(handler)
    logger.propagate = False

    return logger
📄 backend/app/core/exceptions.py
python
"""
Custom exceptions for the AI Autonomous Scientific Laboratory.
"""


class LabBaseException(Exception):
    """Base exception for the whole lab system."""
    pass


class AgentError(LabBaseException):
    """Raised when an AI agent fails."""
    pass


class RobotError(LabBaseException):
    """Raised when robot simulator fails."""
    pass


class ExperimentError(LabBaseException):
    """Raised when experiment logic fails."""
    pass


class OptimizationError(LabBaseException):
    """Raised when Bayesian optimizer fails."""
    pass


class DatabaseError(LabBaseException):
    """Raised when DB operations fail."""
    pass


class ValidationError(LabBaseException):
    """Raised when input validation fails."""
    pass


class GeminiAPIError(LabBaseException):
    """Raised when Gemini API call fails."""
    pass
