📄 base_agent.py — Base Agent Class
File Path: backend/app/agents/base_agent.py

Ye abstract base class hai jisse saare agents inherit karenge.

✅ Complete Code — base_agent.py
python
"""
Base Agent Class
----------------
Saare AI agents (Planner, Executor, Analyzer, Hypothesis, Publisher)
is base class ko inherit karte hain.

Ye class provide karti hai:
- Gemini API client initialization
- Common logging
- DB session handling
- Standard LLM call method
- Agent activity logging
"""

import os
import json
import google.generativeai as genai
from abc import ABC, abstractmethod
from datetime import datetime
from typing import Any, Optional

from sqlalchemy.orm import Session
from app.core.logger import get_logger
from app.core.exceptions import AgentError


class BaseAgent(ABC):
    """
    Abstract base class for all AI agents.

    Har agent ko `name` aur `role` dena zaroori hai.
    Har agent ko `run()` method implement karna hoga.
    """

    def __init__(
        self,
        name: str,
        role: str,
        model_name: str = "gemini-1.5-flash",
        temperature: float = 0.7,
        db: Optional[Session] = None,
    ):
        """
        Args:
            name: Agent ka naam (e.g., "PlannerAgent")
            role: Agent ka kaam (e.g., "Experiment Planning")
            model_name: Gemini model (default: gemini-1.5-flash)
            temperature: Creativity level (0.0 = strict, 1.0 = creative)
            db: SQLAlchemy session (optional)
        """
        self.name = name
        self.role = role
        self.model_name = model_name
        self.temperature = temperature
        self.db = db
        self.logger = get_logger(name)

        # Gemini API initialize karo
        api_key = os.getenv("GEMINI_API_KEY")
        if not api_key:
            raise AgentError(
                f"[{self.name}] GEMINI_API_KEY environment variable missing hai. "
                f".env file check karo."
            )

        genai.configure(api_key=api_key)

        # Generation config
        self.generation_config = {
            "temperature": self.temperature,
            "top_p": 0.95,
            "top_k": 40,
            "max_output_tokens": 2048,
        }

        # Model initialize karo
        try:
            self.model = genai.GenerativeModel(
                model_name=self.model_name,
                generation_config=self.generation_config,
            )
        except Exception as e:
            raise AgentError(f"[{self.name}] Gemini model init fail: {str(e)}")

        self.logger.info(
            f"✅ Agent initialized: {self.name} | Role: {self.role} | Model: {self.model_name}"
        )

    # ==================================================
    # ABSTRACT METHOD — Har agent ko implement karna hai
    # ==================================================
    @abstractmethod
    def run(self, *args, **kwargs) -> Any:
        """
        Main execution method. Har agent isko apne hisaab se implement karega.
        """
        pass

    # ==================================================
    # CORE LLM CALL METHOD
    # ==================================================
    def call_llm(
        self,
        prompt: str,
        expect_json: bool = False,
        retries: int = 2,
    ) -> str | dict:
        """
        Gemini API ko call karta hai aur response deta hai.

        Args:
            prompt: Full prompt text
            expect_json: Agar True, to response ko JSON parse karega
            retries: Failure par kitni baar retry kare

        Returns:
            LLM ka response (str ya dict)
        """
        self.logger.info(f"[{self.name}] LLM call → prompt length: {len(prompt)} chars")

        for attempt in range(retries + 1):
            try:
                response = self.model.generate_content(prompt)

                if not response or not response.text:
                    raise AgentError(f"[{self.name}] Empty response from Gemini")

                text = response.text.strip()

                # JSON cleanup (Gemini sometimes wraps in ```json ... ```)
                if expect_json:
                    text = self._clean_json(text)
                    try:
                        parsed = json.loads(text)
                        self.logger.info(f"[{self.name}] ✅ JSON parsed successfully")
                        return parsed
                    except json.JSONDecodeError as e:
                        self.logger.warning(
                            f"[{self.name}] JSON parse failed (attempt {attempt+1}): {e}"
                        )
                        if attempt == retries:
                            raise AgentError(
                                f"[{self.name}] Invalid JSON after {retries+1} attempts: {text[:200]}"
                            )
                        continue

                self.logger.info(f"[{self.name}] ✅ LLM response received")
                return text

            except Exception as e:
                self.logger.error(
                    f"[{self.name}] LLM call error (attempt {attempt+1}): {str(e)}"
                )
                if attempt == retries:
                    raise AgentError(f"[{self.name}] LLM failed after retries: {str(e)}")

        raise AgentError(f"[{self.name}] Unexpected LLM failure")

    # ==================================================
    # JSON CLEANUP HELPER
    # ==================================================
    @staticmethod
    def _clean_json(text: str) -> str:
        """
        Gemini ke response se ```json ... ``` jaise wrappers hata deta hai.
        """
        text = text.strip()

        # Remove ```json ... ```
        if text.startswith("```json"):
            text = text[7:]
        elif text.startswith("```"):
            text = text[3:]

        if text.endswith("```"):
            text = text[:-3]

        return text.strip()

    # ==================================================
    # ACTIVITY LOGGING
    # ==================================================
    def log_activity(
        self,
        action: str,
        message: str,
        level: str = "INFO",
    ) -> None:
        """
        Agent ki activity ko DB mein log karta hai.

        Args:
            action: Kya kaam kiya (e.g., "PLAN_CREATED")
            message: Detail message
            level: INFO / WARNING / ERROR
        """
        log_entry = {
            "agent_name": self.name,
            "action": action,
            "message": message,
            "level": level,
            "timestamp": datetime.utcnow().isoformat(),
        }

        # Console log
        if level == "ERROR":
            self.logger.error(f"[{self.name}] {action} → {message}")
        elif level == "WARNING":
            self.logger.warning(f"[{self.name}] {action} → {message}")
        else:
            self.logger.info(f"[{self.name}] {action} → {message}")

        # DB log (agar session available hai)
        if self.db is not None:
            try:
                # Circular import avoid karne ke liye local import
                from app.models.agent_log import AgentLog

                db_log = AgentLog(
                    agent_name=self.name,
                    action=action,
                    message=message,
                    timestamp=datetime.utcnow(),
                )
                self.db.add(db_log)
                self.db.commit()
            except Exception as e:
                self.logger.warning(f"[{self.name}] DB log fail: {str(e)}")
                self.db.rollback()

    # ==================================================
    # UTILITY METHODS
    # ==================================================
    def __repr__(self) -> str:
        return f"<{self.name} role='{self.role}' model='{self.model_name}'>"

    def __str__(self) -> str:
        return f"{self.name} ({self.role})"

    def get_info(self) -> dict:
        """Agent ki info dict return karta hai."""
        return {
            "name": self.name,
            "role": self.role,
            "model": self.model_name,
            "temperature": self.temperature,
        }
